# Local PC simulation: no paid API calls and no ASR/TTS model required.
VOICE_ALLOW_SIMULATED_INPUT=true
VOICE_ASR_PROVIDER=mock
VOICE_TTS_PROVIDER=mock
VOICE_LLM_ORDER=mock
VOICE_REPLY_STYLE=normal
VOICE_BILLING_ENABLED=true
VOICE_AUTH_PEPPER=replace-with-a-long-random-server-secret
VOICE_ADMIN_PASSWORD_HASH=generate-with-python-m-cloud_server-cli-hash-admin-password
VOICE_CONFIG_KEY=generate-with-python-m-cloud_server-cli-generate-config-key
VOICE_ADMIN_COOKIE_SECURE=false
VOICE_DATA_DIR=./cloud_server/data
# Optional, private single-recording diagnostics for one authorized device.
# VOICE_DIAGNOSTIC_DEVICE_ID=
VOICE_FIRMWARE_PUBLIC_BASE_URL=https://voice.bsnlch.xyz
# VOICE_FIRMWARE_PUBLIC_KEY=./cloud_server/firmware_public_key.pem
# VOICE_FIRMWARE_HARDWARE_ID=esp32s3-cloud-voice-v1

# Production provider order: DeepSeek -> Qwen -> GLM.
# VOICE_ALLOW_SIMULATED_INPUT=false
# VOICE_ASR_PROVIDER=sensevoice
# VOICE_TTS_PROVIDER=sherpa_vits
# VOICE_LLM_ORDER=deepseek,qwen,glm
# DEEPSEEK_API_KEY=
# QWEN_API_KEY=
# GLM_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation
# QWEN_MODEL=qwen-plus
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GLM_MODEL=glm-4.7-flash
# Custom external / server-local LLM entries are not enabled by default.
# CUSTOM_LLM_API_KEY=
# CUSTOM_LLM_BASE_URL=https://api.example.com/v1
# CUSTOM_LLM_MODEL=custom-model
# CUSTOM_LLM_PROTOCOL=openai
# LOCAL_LLM_API_KEY=
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
# LOCAL_LLM_MODEL=qwen3:8b
# LOCAL_LLM_PROTOCOL=ollama
# Speech routing: local_only, local_first, cloud_first, cloud_only.
# VOICE_ASR_ROUTE=local_only
# VOICE_TTS_ROUTE=local_only
# CLOUD_SPEECH_API_KEY=
# CLOUD_SPEECH_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
# CLOUD_ASR_MODEL=paraformer-realtime-v2
# CLOUD_TTS_MODEL=sambert-zhida-v1
# SENSEVOICE_MODEL=/opt/voice/models/sensevoice/model.int8.onnx
# SENSEVOICE_TOKENS=/opt/voice/models/sensevoice/tokens.txt
# SHERPA_TTS_MODEL=/opt/voice/models/vits/model.onnx
# SHERPA_TTS_TOKENS=/opt/voice/models/vits/tokens.txt
# SHERPA_TTS_LEXICON=/opt/voice/models/vits/lexicon.txt
# SHERPA_TTS_DATA_DIR=
# SHERPA_ENGLISH_TTS_MODEL=/opt/voice/models/vits-piper-en_US-libritts_r-medium/en_US-libritts_r-medium.onnx
# SHERPA_ENGLISH_TTS_TOKENS=/opt/voice/models/vits-piper-en_US-libritts_r-medium/tokens.txt
# SHERPA_ENGLISH_TTS_DATA_DIR=/opt/voice/models/vits-piper-en_US-libritts_r-medium/espeak-ng-data
# SHERPA_TTS_SPEAKER_ID=0
# SHERPA_TTS_SPEED=1.0
