# Local PC simulation: no paid API calls and no ASR/TTS model required.
VOICE_ALLOW_SIMULATED_INPUT=true
VOICE_ASR_PROVIDER=mock
VOICE_TTS_PROVIDER=mock
VOICE_LLM_ORDER=mock
VOICE_AUTH_PEPPER=replace-with-a-long-random-server-secret
VOICE_ADMIN_PASSWORD_HASH=generate-with-python-m-cloud_server-cli-hash-admin-password
VOICE_CONFIG_KEY=generate-with-python-m-cloud_server-cli-generate-config-key
VOICE_ADMIN_COOKIE_SECURE=false
VOICE_DATA_DIR=./cloud_server/data

